{
  "name": "csvsist",
  "version": "1.0.0",
  "private": true,
  "description": "CSVSIST - ERP de confecção da ConServ: materiais, corte, engenharia, produção e canal",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "setup": "npm install && npm run db:init",
    "db:init": "npm run -w server db:init",
    "start": "npm run -w server start",
    "dev": "npm run -w server dev",
    "test": "npm run -w server test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}

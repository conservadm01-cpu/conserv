{
  "name": "conserv-erp",
  "version": "1.0.0",
  "private": true,
  "description": "ERP Conserv - controle de materiais e processos de produção (confecção)",
  "type": "module",
  "workspaces": ["server", "web"],
  "scripts": {
    "setup": "npm install && npm run db:init",
    "db:init": "npm run -w server db:init",
    "db:seed": "npm run -w server db:seed",
    "db:seed-fabrica": "npm run -w server db:seed-fabrica",
    "import": "npm run -w server import --",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run -w server dev",
    "dev:web": "npm run -w web dev",
    "build": "npm run -w web build",
    "start": "npm run -w server start",
    "test": "npm run -w server test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": { "node": ">=20" }
}

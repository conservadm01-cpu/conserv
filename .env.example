# Porta do servidor da API (e do app em produção)
PORT=3333

# Caminho do banco SQLite
DB_PATH=./data/conserv.db

# Segredo de assinatura dos tokens de sessão — TROQUE em produção
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES=12h

# Credenciais do usuário administrador criado por "npm run db:init"
ADMIN_EMAIL=admin@conserv.com.br
ADMIN_SENHA=conserv123

// Plataforma Estudos Musicais — modelo de dados.
// Convenções: nomes em português; toda leitura de dados de aluno passa por
// vínculo territorial (comum/região) resolvido no servidor, nunca pelo cliente.

generator client {
  provider = "prisma-client-js"
  output   = "../src/gerado/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================ território

model Regiao {
  id            String   @id @default(cuid())
  nome          String
  codigo        String?  @unique
  cidadeUf      String?
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  comuns        Comum[]
  vinculos      Vinculo[]

  @@index([ativo])
  @@map("regioes")
}

model Comum {
  id            String   @id @default(cuid())
  nome          String
  codigo        String?  @unique
  regiaoId      String
  cidade        String
  estado        String   @db.VarChar(2)
  endereco      String?
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  regiao        Regiao   @relation(fields: [regiaoId], references: [id], onDelete: Restrict)
  vinculos      Vinculo[]
  alunos        PerfilAluno[]
  turmas        Turma[]

  @@unique([regiaoId, nome])
  @@index([ativo])
  @@map("comuns")
}

// ======================================================== pessoas e acesso

enum StatusUsuario {
  PENDENTE
  ATIVO
  INATIVO
  BLOQUEADO
}

model Usuario {
  id                  String        @id @default(cuid())
  nomeCompleto        String
  email               String        @unique
  telefone            String?
  nascimento          DateTime?     @db.Date
  senhaHash           String
  status              StatusUsuario @default(PENDENTE)
  aceiteTermosEm      DateTime?
  versaoPrivacidade   String?
  ultimoAcessoEm      DateTime?
  criadoEm            DateTime      @default(now())
  atualizadoEm        DateTime      @updatedAt

  vinculos            Vinculo[]      @relation("vinculosDoUsuario")
  vinculosConcedidos  Vinculo[]      @relation("vinculosConcedidos")
  perfilAluno         PerfilAluno?   @relation("perfilDoAluno")
  alunosComoInstrutor PerfilAluno[]  @relation("instrutorDoAluno")
  sessoes             Sessao[]
  solicitacoes        Solicitacao[]  @relation("solicitante")
  decisoes            Solicitacao[]  @relation("decisor")
  auditorias          Auditoria[]
  sessoesEstudo       SessaoEstudo[]
  visualizacoes       VisualizacaoPagina[]
  tempos              TempoDiario[]
  progressoLicoes     ProgressoLicao[]
  progressoUnidades   ProgressoUnidade[]
  jornadas            JornadaDoAluno[]      @relation("alunoDaJornada")
  turmasComoInstrutor Turma[]               @relation("instrutorDaTurma")
  matriculas          MatriculaEmTurma[]
  documentosEnviados  DocumentoMetodo[]
  autorizacoesDeMetodo MetodoInstrumento[]
  analisesRevisadas   AnaliseDeMetodo[]
  tentativas          TentativaAvaliacao[]  @relation("alunoDaTentativa")
  correcoes           TentativaAvaliacao[]  @relation("corretorDaTentativa")
  questoesRecebidas   QuestaoRecebida[]
  envios              Envio[]        @relation("alunoDoEnvio")
  avaliacoesFeitas    AvaliacaoEnvio[]
  medalhas            Medalha[]      @relation("alunoDaMedalha")
  medalhasConcedidas  Medalha[]      @relation("instrutorDaMedalha")
  certificados        Certificado[]
  importacoes         Importacao[]
  questoesEscritas    Questao[]      @relation("autorDaQuestao")
  questoesRevisadas   Questao[]      @relation("revisorDaQuestao")
  arquivos            Arquivo[]

  @@index([status])
  @@map("usuarios")
}

enum Papel {
  SUPERADMIN
  ADMIN_PEDAGOGICO
  INSTRUTOR
  ENCARREGADO_LOCAL
  ENCARREGADO_REGIONAL
  ANCIAO
  ALUNO
}

enum EscopoVinculo {
  GLOBAL
  REGIAO
  COMUM
}

/// Um usuário pode ter vários vínculos; cada um carrega papel + escopo
/// territorial. É a fonte única de autorização — nada vem do navegador.
model Vinculo {
  id            String        @id @default(cuid())
  usuarioId     String
  papel         Papel
  escopo        EscopoVinculo
  regiaoId      String?
  comumId       String?
  ativo         Boolean       @default(true)
  concedidoPorId String?
  concedidoEm   DateTime      @default(now())
  revogadoEm    DateTime?
  observacao    String?

  usuario       Usuario  @relation("vinculosDoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  concedidoPor  Usuario? @relation("vinculosConcedidos", fields: [concedidoPorId], references: [id], onDelete: SetNull)
  regiao        Regiao?  @relation(fields: [regiaoId], references: [id], onDelete: Cascade)
  comum         Comum?   @relation(fields: [comumId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, papel, escopo, regiaoId, comumId])
  @@index([usuarioId, ativo])
  @@index([papel, ativo])
  @@map("vinculos")
}

model Sessao {
  id          String    @id @default(cuid())
  usuarioId   String
  tokenHash   String    @unique
  criadaEm    DateTime  @default(now())
  expiraEm    DateTime
  encerradaEm DateTime?
  ipHash      String?
  navegador   String?

  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, expiraEm])
  @@map("sessoes")
}

enum SituacaoAluno {
  AGUARDANDO_APROVACAO
  APROVADO
  RECUSADO
  DESATIVADO
}

model PerfilAluno {
  id                     String        @id @default(cuid())
  usuarioId              String        @unique
  comumId                String
  instrumentoId          String?
  instrutorId            String?
  encarregadoLocalNome   String?
  encarregadoRegionalNome String?
  anciaoNome             String?
  situacao               SituacaoAluno @default(AGUARDANDO_APROVACAO)
  aprovadoPorId          String?
  aprovadoEm             DateTime?
  responsavelNome        String?
  responsavelParentesco  String?
  responsavelTelefone    String?
  responsavelEmail       String?
  criadoEm               DateTime      @default(now())
  atualizadoEm           DateTime      @updatedAt

  usuario      Usuario      @relation("perfilDoAluno", fields: [usuarioId], references: [id], onDelete: Cascade)
  comum        Comum        @relation(fields: [comumId], references: [id], onDelete: Restrict)
  instrumento  Instrumento? @relation(fields: [instrumentoId], references: [id], onDelete: SetNull)
  instrutor    Usuario?     @relation("instrutorDoAluno", fields: [instrutorId], references: [id], onDelete: SetNull)

  @@index([comumId, situacao])
  @@index([instrutorId])
  @@map("perfis_aluno")
}

enum TipoSolicitacao {
  TROCA_INSTRUMENTO
  TRANSFERENCIA_COMUM
  INCLUSAO_RESPONSAVEL
  AVANCO_FASE
  ACESSO
}

enum StatusSolicitacao {
  ABERTA
  DEFERIDA
  INDEFERIDA
  CANCELADA
}

model Solicitacao {
  id           String            @id @default(cuid())
  tipo         TipoSolicitacao
  usuarioId    String
  dados        Json
  justificativa String?
  status       StatusSolicitacao @default(ABERTA)
  decididoPorId String?
  decididoEm   DateTime?
  parecer      String?
  criadoEm     DateTime          @default(now())

  usuario      Usuario  @relation("solicitante", fields: [usuarioId], references: [id], onDelete: Cascade)
  decididoPor  Usuario? @relation("decisor", fields: [decididoPorId], references: [id], onDelete: SetNull)

  @@index([status, tipo])
  @@map("solicitacoes")
}

model Auditoria {
  id          String   @id @default(cuid())
  usuarioId   String?
  acao        String
  entidade    String
  entidadeId  String?
  antes       Json?
  depois      Json?
  ipHash      String?
  criadoEm    DateTime @default(now())

  usuario     Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([entidade, entidadeId])
  @@index([criadoEm])
  @@map("auditorias")
}

// ============================================================ instrumentos

model CategoriaInstrumento {
  id          String        @id @default(cuid())
  nome        String        @unique
  codigo      String?       @unique
  descricao   String?
  ordem       Int           @default(0)
  status      Situacao      @default(ATIVO)
  instrumentos Instrumento[]

  @@map("categorias_instrumento")
}

enum Clave {
  SOL
  DO
  FA
}

enum Situacao {
  ATIVO
  INATIVO
  RASCUNHO
  ARQUIVADO
}

/// Qualquer instrumento pode ser cadastrado pelo painel — inclusive Canto e
/// Teoria Musical, que não têm clave nem transposição. Nada aqui é lista fixa
/// no código.
model Instrumento {
  id                    String   @id @default(cuid())
  nome                  String   @unique
  codigo                String?  @unique
  descricao             String?
  categoriaId           String
  afinacao              String   @default("Dó")
  transposicaoGrau      Int      @default(0)
  transposicaoSemitons  Int      @default(0)
  transposicaoDescricao String?
  clavePrincipal        Clave?
  clavesAlternativas    Clave[]  @default([])
  extensaoEscrita       String?
  observacoesTecnicas   String?
  status                Situacao @default(ATIVO)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  categoria             CategoriaInstrumento @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  alunos                PerfilAluno[]
  metodos               Metodo[]
  metodosAutorizados    MetodoInstrumento[]
  jornadas              JornadaDoAluno[]
  turmas                Turma[]
  questoes              Questao[]
  licoes                Licao[]

  @@index([status])
  @@map("instrumentos")
}

// ================================================================== métodos

enum EscopoDoMetodo {
  INSTRUMENTO
  TRANSVERSAL
}

/// Método de ensino cadastrado na plataforma. MSA, Melodia em Movimento e o
/// método de cada instrumento são LINHAS desta tabela — nunca ramificações no
/// código. Um método transversal (teoria, percepção) não pertence a um
/// instrumento e só alcança outro instrumento por autorização explícita.
model Metodo {
  id             String         @id @default(cuid())
  nome           String
  codigo         String         @unique
  escopo         EscopoDoMetodo @default(INSTRUMENTO)
  instrumentoId  String?
  autor          String?
  organizacao    String?
  versao         String?
  descricao      String?
  nivel          String?
  totalFases     Int?
  /// Conteúdo deste método pode ser reaproveitado por outro método?
  /// Só vale junto com uma autorização em MetodoInstrumento.
  conteudoCompartilhado Boolean  @default(false)
  notaDireitos   String?
  status         Situacao       @default(RASCUNHO)
  documentoOrigemId String?
  criadoEm       DateTime       @default(now())
  atualizadoEm   DateTime       @updatedAt

  instrumento    Instrumento?   @relation(fields: [instrumentoId], references: [id], onDelete: SetNull)
  documentos     DocumentoMetodo[]
  curriculos     Curriculo[]
  competencias   Competencia[]
  configuracoes  ConfiguracaoDoMetodo[]
  autorizacoes   MetodoInstrumento[]
  jornadas       JornadaDoAluno[]
  turmas         Turma[]
  licoes         Licao[]
  questoes       Questao[]
  analises       AnaliseDeMetodo[]
  medalhas       Medalha[]
  certificados   Certificado[]
  avaliacoes     Avaliacao[]

  @@index([escopo, status])
  @@map("metodos")
}

/// Autorização para um método (normalmente transversal) ser usado com um
/// instrumento. Sem esta linha, o conteúdo de um método não aparece na
/// jornada de outro.
model MetodoInstrumento {
  metodoId      String
  instrumentoId String
  autorizadoPorId String?
  autorizadoEm  DateTime @default(now())
  observacao    String?

  metodo        Metodo      @relation(fields: [metodoId], references: [id], onDelete: Cascade)
  instrumento   Instrumento @relation(fields: [instrumentoId], references: [id], onDelete: Cascade)
  autorizadoPor Usuario?    @relation(fields: [autorizadoPorId], references: [id], onDelete: SetNull)

  @@id([metodoId, instrumentoId])
  @@map("metodos_instrumentos")
}

enum TipoDeDocumento {
  PDF
  MSCZ
  MUSICXML
  MP3
  WAV
  PNG
  JPG
  MP4
  TXT
  DOCX
  XLSX
  CSV
  OUTRO
}

/// Documento de origem do método: é dele que a análise tira a estrutura, e é
/// a ele que toda proveniência aponta.
model DocumentoMetodo {
  id          String          @id @default(cuid())
  metodoId    String
  nomeArquivo String
  tipoArquivo TipoDeDocumento
  arquivoId   String?
  caminho     String?
  versao      String?
  descricao   String?
  fonte       String?
  enviadoPorId String?
  enviadoEm   DateTime        @default(now())
  status      Situacao        @default(ATIVO)

  metodo      Metodo    @relation(fields: [metodoId], references: [id], onDelete: Cascade)
  arquivo     Arquivo?  @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  enviadoPor  Usuario?  @relation(fields: [enviadoPorId], references: [id], onDelete: SetNull)
  unidades    UnidadeCurricular[]
  licoes      Licao[]
  analises    AnaliseDeMetodo[]

  @@index([metodoId, status])
  @@map("documentos_metodo")
}

/// Competências do método — postura, arco, embocadura, leitura… Cada método
/// define as suas; não há lista fixa no código.
model Competencia {
  id          String   @id @default(cuid())
  metodoId    String
  codigo      String
  nome        String
  descricao   String?
  ordem       Int      @default(0)
  peso        Int      @default(1)
  status      Situacao @default(ATIVO)

  metodo      Metodo   @relation(fields: [metodoId], references: [id], onDelete: Cascade)
  avaliacoes  CriterioDaAvaliacao[]

  @@unique([metodoId, codigo])
  @@map("competencias")
}

enum ChaveDeConfiguracao {
  NOTA_MINIMA
  TENTATIVAS_MAXIMAS
  QUESTOES_POR_AVALIACAO
  PERCENTUAL_DE_APROVEITAMENTO
  EXIGE_APROVACAO_INSTRUTOR
  PRE_REQUISITO_DE_UNIDADES
  PESOS_DE_COMPETENCIA
  OUTRO
}

/// Configuração pedagógica POR MÉTODO. É o que impede o critério do MSA de
/// cair automaticamente sobre um método de violino: cada método traz o seu,
/// e quem não define herda o padrão da plataforma, declarado no seed.
model ConfiguracaoDoMetodo {
  id         String              @id @default(cuid())
  metodoId   String
  chave      ChaveDeConfiguracao
  valor      Json
  descricao  String?
  versao     Int                 @default(1)
  vigenteDe  DateTime            @default(now())
  vigenteAte DateTime?

  metodo     Metodo              @relation(fields: [metodoId], references: [id], onDelete: Cascade)

  @@unique([metodoId, chave, versao])
  @@map("configuracoes_metodo")
}

// ================================================================ conteúdo

enum StatusDoCurriculo {
  RASCUNHO
  EM_REVISAO
  PUBLICADO
  ARQUIVADO
}

/// Currículo é uma versão da estrutura de um método. Publicar um currículo
/// novo não reescreve o histórico de quem estudou pelo anterior.
model Curriculo {
  id          String            @id @default(cuid())
  metodoId    String
  rotulo      String
  versao      Int               @default(1)
  descricao   String?
  status      StatusDoCurriculo @default(RASCUNHO)
  vigenteDe   DateTime?
  vigenteAte  DateTime?
  origemAnaliseId String?
  criadoEm    DateTime          @default(now())
  atualizadoEm DateTime         @updatedAt

  metodo      Metodo            @relation(fields: [metodoId], references: [id], onDelete: Cascade)
  unidades    UnidadeCurricular[]
  jornadas    JornadaDoAluno[]

  @@unique([metodoId, versao])
  @@map("curriculos")
}

/// Tipos possíveis de unidade. Um método pode usar só FASE, outro NIVEL →
/// FASE → MODULO, outro só MODULO. A profundidade é do método, não do código.
enum TipoDeUnidade {
  NIVEL
  FASE
  MODULO
  AULA
  TOPICO
}

/// A estrutura pedagógica em árvore.
///
/// É a peça que torna a plataforma method-agnostic: em vez de tabelas fixas
/// de "fase" e "tópico", cada método monta a sua própria hierarquia com a
/// profundidade que tiver. 10 fases, 16 fases, 8 níveis ou 20 módulos são o
/// mesmo modelo, com dados diferentes.
model UnidadeCurricular {
  id           String        @id @default(cuid())
  curriculoId  String
  paiId        String?
  tipo         TipoDeUnidade
  codigo       String
  nome         String
  descricao    String?
  ordem        Int           @default(0)
  profundidade Int           @default(0)
  /// Caminho materializado ("1/1.4/1.4.2") para listar a subárvore numa
  /// consulta só, sem recursão a cada tela.
  caminho      String        @default("")

  // ------------------------------------------------------- proveniência
  documentoOrigemId    String?
  paginaOrigemInicio   Int?
  paginaOrigemFim      Int?
  referenciaOrigem     String?
  statusConferencia    StatusConferencia @default(PENDENTE_CONFERENCIA)

  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  curriculo    Curriculo     @relation(fields: [curriculoId], references: [id], onDelete: Cascade)
  pai          UnidadeCurricular?  @relation("arvoreDaUnidade", fields: [paiId], references: [id], onDelete: Cascade)
  filhas       UnidadeCurricular[] @relation("arvoreDaUnidade")
  documentoOrigem DocumentoMetodo? @relation(fields: [documentoOrigemId], references: [id], onDelete: SetNull)

  licoes       Licao[]
  questoes     Questao[]
  progresso    ProgressoUnidade[]
  jornadas     JornadaDoAluno[]
  turmas       Turma[]
  medalhas     Medalha[]

  @@unique([curriculoId, codigo])
  @@index([curriculoId, tipo, ordem])
  @@index([paiId, ordem])
  @@index([caminho])
  @@map("unidades_curriculares")
}

enum TipoLicao {
  LEITURA_METRICA
  LEITURA_RITMICA
  CONSTRUCAO_ESCALA
  HINO
  PREPARATORIO_RITMICO
  ATIVIDADE_APOIO
  TEORIA
}

enum StatusConferencia {
  CONFERIDO
  PENDENTE_CONFERENCIA
  DIVERGENTE
}

enum StatusPublicacao {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
}

/// Item de estudo (lição, exercício, peça). Guarda a numeração ORIGINAL do
/// método e carrega a proveniência completa: método, instrumento, unidade,
/// documento, página e referência. Nunca se perde de onde o conteúdo veio.
model Licao {
  id                String            @id @default(cuid())
  unidadeId         String
  metodoId          String
  instrumentoId     String?
  numeroOriginal    String
  /// Distingue itens que dividem o mesmo rótulo na fonte — por exemplo,
  /// "Exemplo de construção", uma vez para cada escala. Vazio (não nulo)
  /// quando não há variante: em índice único, NULL não impediria duplicatas.
  variante          String            @default("")
  titulo            String
  tipo              TipoLicao
  ordemPedagogica   Int               @default(0)
  objetivos         String?
  preRequisitos     String?
  /// Conteúdo reaproveitável por outro método, quando houver autorização.
  compartilhado     Boolean           @default(false)

  // ------------------------------------------------------- proveniência
  documentoOrigemId String?
  paginaOrigemInicio Int?
  paginaOrigemFim   Int?
  referenciaOrigem  String?
  fonte             String?

  observacoes       String?
  statusConferencia StatusConferencia @default(PENDENTE_CONFERENCIA)
  statusPublicacao  StatusPublicacao  @default(RASCUNHO)
  versao            Int               @default(1)
  criadoEm          DateTime          @default(now())
  atualizadoEm      DateTime          @updatedAt

  unidade           UnidadeCurricular @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  metodo            Metodo            @relation(fields: [metodoId], references: [id], onDelete: Cascade)
  instrumento       Instrumento?      @relation(fields: [instrumentoId], references: [id], onDelete: SetNull)
  documentoOrigem   DocumentoMetodo?  @relation(fields: [documentoOrigemId], references: [id], onDelete: SetNull)

  versoes           VersaoLicao[]
  conteudos         Conteudo[]
  atividades        Atividade[]
  questoes          Questao[]
  agrupamentos      LicaoAgrupamento[]
  progresso         ProgressoLicao[]
  visualizacoes     VisualizacaoPagina[]
  batimentos        Batimento[]

  @@unique([unidadeId, numeroOriginal, variante])
  @@index([metodoId, statusPublicacao])
  @@index([tipo, statusPublicacao])
  @@map("licoes")
}

model VersaoLicao {
  id                   String            @id @default(cuid())
  licaoId              String
  clave                Clave
  criterioClave        String?
  paginaImpressaInicio Int?
  paginaImpressaFim    Int?
  paginaArquivoInicio  Int?
  paginaArquivoFim     Int?
  armadura             String?
  escalaReferencia     String?
  compassos            String[]          @default([])
  tipoLeitura          String?
  observacoes          String?
  fonte                String?
  statusConferencia    StatusConferencia @default(PENDENTE_CONFERENCIA)

  licao                Licao             @relation(fields: [licaoId], references: [id], onDelete: Cascade)
  visualizacoes        VisualizacaoPagina[]

  @@unique([licaoId, clave])
  @@index([escalaReferencia, clave])
  @@map("versoes_licao")
}

enum TipoAgrupamento {
  ESCALA
  CLAVE
  COMPASSO
  TIPO_LEITURA
  ASSUNTO
}

/// Navegação por assunto (escala → clave → compasso). É complementar à
/// ordem oficial do método: agrupa sem duplicar a lição nem o histórico.
model Agrupamento {
  id      String          @id @default(cuid())
  tipo    TipoAgrupamento
  valor   String
  rotulo  String
  ordem   Int             @default(0)

  licoes  LicaoAgrupamento[]

  @@unique([tipo, valor])
  @@map("agrupamentos")
}

model LicaoAgrupamento {
  licaoId       String
  agrupamentoId String

  licao         Licao       @relation(fields: [licaoId], references: [id], onDelete: Cascade)
  agrupamento   Agrupamento @relation(fields: [agrupamentoId], references: [id], onDelete: Cascade)

  @@id([licaoId, agrupamentoId])
  @@map("licoes_agrupamentos")
}

enum TipoConteudo {
  TEXTO
  PDF
  IMAGEM
  AUDIO
  VIDEO
  PARTITURA
  EXERCICIO_INTERATIVO
  QUESTIONARIO
  TAREFA_PRATICA
  SOLFEJO
  EXECUCAO_INSTRUMENTAL
}

model Conteudo {
  id        String       @id @default(cuid())
  licaoId   String
  tipo      TipoConteudo
  titulo    String
  corpo     String?
  arquivoId String?
  ordem     Int          @default(0)
  publicado Boolean      @default(false)

  licao     Licao        @relation(fields: [licaoId], references: [id], onDelete: Cascade)
  arquivo   Arquivo?     @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  batimentos Batimento[]

  @@index([licaoId, ordem])
  @@map("conteudos")
}

/// Todo arquivo é privado: o acesso passa por rota autenticada que confere
/// o vínculo de quem pede e devolve URL temporária.
model Arquivo {
  id           String   @id @default(cuid())
  chave        String   @unique
  nomeOriginal String
  mime         String
  tamanho      Int
  hashSha256   String?
  enviadoPorId String?
  criadoEm     DateTime @default(now())
  retencaoAte  DateTime?

  enviadoPor   Usuario? @relation(fields: [enviadoPorId], references: [id], onDelete: SetNull)
  conteudos    Conteudo[]
  enviosArquivo EnvioArquivo[]
  certificados Certificado[]
  documentosDeMetodo DocumentoMetodo[]

  @@map("arquivos")
}

// ============================================================== avaliações

enum TipoQuestao {
  MULTIPLA_ESCOLHA
  VERDADEIRO_FALSO
  ASSOCIACAO
  ORDENACAO
  RESPOSTA_CURTA
  DISCURSIVA
  IDENTIFICACAO_NOTAS
  FIGURAS_E_PAUSAS
  FORMULA_DE_COMPASSO
  ARMADURA_E_ESCALA
  LEITURA_RITMICA
  AUDITIVA
  PRATICA
}

enum StatusRevisao {
  RASCUNHO
  EM_REVISAO
  APROVADA
  ARQUIVADA
}

enum OrigemQuestao {
  MANUAL
  IMPORTADA
  GERADA
}

model Questao {
  id             String        @id @default(cuid())
  metodoId       String
  unidadeId      String?
  licaoId        String?
  instrumentoId  String?
  competenciaId  String?
  tipo           TipoQuestao
  enunciado      String
  alternativas   Json?
  resposta       Json
  explicacao     String?
  paginaReferencia Int?
  dificuldade    Int           @default(1)
  tags           String[]      @default([])
  statusRevisao  StatusRevisao @default(RASCUNHO)
  origem         OrigemQuestao @default(MANUAL)
  autorId        String?
  revisorId      String?
  versao         Int           @default(1)
  criadoEm       DateTime      @default(now())
  atualizadoEm   DateTime      @updatedAt

  metodo         Metodo            @relation(fields: [metodoId], references: [id], onDelete: Cascade)
  unidade        UnidadeCurricular? @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  licao          Licao?            @relation(fields: [licaoId], references: [id], onDelete: SetNull)
  instrumento    Instrumento?  @relation(fields: [instrumentoId], references: [id], onDelete: SetNull)
  autor          Usuario?      @relation("autorDaQuestao", fields: [autorId], references: [id], onDelete: SetNull)
  revisor        Usuario?      @relation("revisorDaQuestao", fields: [revisorId], references: [id], onDelete: SetNull)
  recebidas      QuestaoRecebida[]

  @@index([metodoId, statusRevisao])
  @@index([instrumentoId, statusRevisao])
  @@map("questoes")
}

enum EscopoAvaliacao {
  LICAO
  UNIDADE
  METODO
}

/// Avaliação de um método. Os parâmetros vêm do próprio método (nota mínima,
/// tentativas, quantidade de questões); nada é herdado de outro método.
model Avaliacao {
  id                String          @id @default(cuid())
  metodoId          String
  escopo            EscopoAvaliacao
  referenciaId      String?
  nome              String
  quantidadeQuestoes Int?
  notaMinima        Int?
  tentativasMax     Int?
  regras            Json?
  status            Situacao        @default(ATIVO)
  criadoEm          DateTime        @default(now())

  metodo            Metodo          @relation(fields: [metodoId], references: [id], onDelete: Cascade)
  tentativas        TentativaAvaliacao[]
  criterios         CriterioDaAvaliacao[]

  @@unique([metodoId, escopo, referenciaId, nome])
  @@map("avaliacoes")
}

/// Liga a avaliação às competências do método, com peso próprio.
model CriterioDaAvaliacao {
  id            String @id @default(cuid())
  avaliacaoId   String
  competenciaId String
  peso          Int    @default(1)
  descricao     String?

  avaliacao     Avaliacao   @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  competencia   Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)

  @@unique([avaliacaoId, competenciaId])
  @@map("criterios_avaliacao")
}

model TentativaAvaliacao {
  id            String    @id @default(cuid())
  avaliacaoId   String
  alunoId       String
  iniciadaEm    DateTime  @default(now())
  finalizadaEm  DateTime?
  nota          Int?
  aprovado      Boolean?
  questoes      Json
  respostas     Json?
  corrigidaPorId String?
  observacao    String?

  avaliacao     Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  aluno         Usuario   @relation("alunoDaTentativa", fields: [alunoId], references: [id], onDelete: Cascade)
  corrigidaPor  Usuario?  @relation("corretorDaTentativa", fields: [corrigidaPorId], references: [id], onDelete: SetNull)
  recebidas     QuestaoRecebida[]

  @@index([alunoId, avaliacaoId])
  @@map("tentativas_avaliacao")
}

/// Guarda o que cada aluno já recebeu, para a mesma pergunta nunca repetir.
model QuestaoRecebida {
  id          String   @id @default(cuid())
  alunoId     String
  questaoId   String?
  assinatura  String
  tentativaId String?
  recebidaEm  DateTime @default(now())

  aluno       Usuario  @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  questao     Questao? @relation(fields: [questaoId], references: [id], onDelete: SetNull)
  tentativa   TentativaAvaliacao? @relation(fields: [tentativaId], references: [id], onDelete: SetNull)

  @@unique([alunoId, assinatura])
  @@index([alunoId])
  @@map("questoes_recebidas")
}

// ================================================== atividades práticas

model Atividade {
  id          String       @id @default(cuid())
  licaoId     String
  tipo        TipoConteudo
  titulo      String
  instrucoes  String?
  criterios   Json?
  obrigatoria Boolean      @default(true)
  peso        Int          @default(1)
  ativo       Boolean      @default(true)

  licao       Licao        @relation(fields: [licaoId], references: [id], onDelete: Cascade)
  envios      Envio[]

  @@index([licaoId])
  @@map("atividades")
}

enum EstadoEnvio {
  NAO_INICIADA
  EM_ANDAMENTO
  ENVIADA
  EM_AVALIACAO
  CORRECAO_SOLICITADA
  APROVADA
  REPROVADA
  DISPENSADA
}

model Envio {
  id            String      @id @default(cuid())
  atividadeId   String
  alunoId       String
  estado        EstadoEnvio @default(NAO_INICIADA)
  tentativa     Int         @default(1)
  comentario    String?
  enviadoEm     DateTime?
  atualizadoEm  DateTime    @updatedAt
  criadoEm      DateTime    @default(now())

  atividade     Atividade   @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  aluno         Usuario     @relation("alunoDoEnvio", fields: [alunoId], references: [id], onDelete: Cascade)
  arquivos      EnvioArquivo[]
  avaliacoes    AvaliacaoEnvio[]

  @@unique([atividadeId, alunoId, tentativa])
  @@index([estado])
  @@map("envios")
}

model EnvioArquivo {
  envioId   String
  arquivoId String

  envio     Envio   @relation(fields: [envioId], references: [id], onDelete: Cascade)
  arquivo   Arquivo @relation(fields: [arquivoId], references: [id], onDelete: Cascade)

  @@id([envioId, arquivoId])
  @@map("envios_arquivos")
}

enum DecisaoAvaliacao {
  APROVADO
  CORRECAO_SOLICITADA
  REPROVADO
  DISPENSADO
}

model AvaliacaoEnvio {
  id          String           @id @default(cuid())
  envioId     String
  avaliadorId String
  decisao     DecisaoAvaliacao
  nota        Int?
  criterios   Json?
  comentarios String?
  criadoEm    DateTime         @default(now())

  envio       Envio            @relation(fields: [envioId], references: [id], onDelete: Cascade)
  avaliador   Usuario          @relation(fields: [avaliadorId], references: [id], onDelete: Restrict)

  @@index([envioId])
  @@map("avaliacoes_envio")
}

// ========================================================= tempo de estudo

model SessaoEstudo {
  id           String    @id @default(cuid())
  usuarioId    String
  inicio       DateTime  @default(now())
  fim          DateTime?
  ipHash       String?
  dispositivo  String?
  segundosAtivos Int     @default(0)

  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  batimentos   Batimento[]

  @@index([usuarioId, inicio])
  @@map("sessoes_estudo")
}

/// Batimento validado no servidor: o cliente diz onde está, o servidor decide
/// quantos segundos valem, com teto por intervalo e sem contagem duplicada.
model Batimento {
  id             String   @id @default(cuid())
  sessaoEstudoId String
  licaoId        String?
  conteudoId     String?
  navegacaoId    String
  recebidoEm     DateTime @default(now())
  segundosValidos Int
  visivel        Boolean  @default(true)

  sessaoEstudo   SessaoEstudo @relation(fields: [sessaoEstudoId], references: [id], onDelete: Cascade)
  licao          Licao?       @relation(fields: [licaoId], references: [id], onDelete: SetNull)
  conteudo       Conteudo?    @relation(fields: [conteudoId], references: [id], onDelete: SetNull)

  @@index([sessaoEstudoId, recebidoEm])
  @@index([navegacaoId])
  @@map("batimentos")
}

model VisualizacaoPagina {
  id             String   @id @default(cuid())
  usuarioId      String
  licaoId        String
  versaoLicaoId  String?
  paginaImpressa Int?
  navegacaoId    String
  primeiraEm     DateTime @default(now())
  ultimaEm       DateTime @default(now())
  segundos       Int      @default(0)
  acessos        Int      @default(1)

  usuario        Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  licao          Licao        @relation(fields: [licaoId], references: [id], onDelete: Cascade)
  versaoLicao    VersaoLicao? @relation(fields: [versaoLicaoId], references: [id], onDelete: SetNull)

  @@unique([navegacaoId])
  @@index([usuarioId, licaoId])
  @@map("visualizacoes_pagina")
}

model TempoDiario {
  id                 String   @id @default(cuid())
  usuarioId          String
  dia                DateTime @db.Date
  segundosSessao     Int      @default(0)
  segundosAtivos     Int      @default(0)
  segundosDedicacao  Int      @default(0)
  paginasDistintas   Int      @default(0)
  licoesIniciadas    Int      @default(0)
  licoesConcluidas   Int      @default(0)

  usuario            Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, dia])
  @@index([dia])
  @@map("tempos_diarios")
}

// ================================================ progresso, regras e prêmios

enum TipoRegra {
  PRE_REQUISITO_FASES
  PERCENTUAL_APROVEITAMENTO
  APROVACAO_INSTRUTOR
  CONCLUSAO_CURSO
}

/// As regras pedagógicas ficam em tabela, com versão — nunca espalhadas
/// pelo código. Cada progresso guarda a versão da regra que o liberou.
model RegraProgressao {
  id          String    @id @default(cuid())
  codigo      String
  versao      Int       @default(1)
  tipo        TipoRegra
  descricao   String
  parametros  Json
  ativo       Boolean   @default(true)
  vigenteDe   DateTime  @default(now())
  vigenteAte  DateTime?
  criadoEm    DateTime  @default(now())

  @@unique([codigo, versao])
  @@map("regras_progressao")
}

enum EstadoProgresso {
  NAO_INICIADO
  EM_ANDAMENTO
  CONCLUIDO
  APROVADO
  REPROVADO
}

model ProgressoLicao {
  id           String          @id @default(cuid())
  alunoId      String
  licaoId      String
  jornadaId    String?
  estado       EstadoProgresso @default(NAO_INICIADO)
  peso         Int             @default(1)
  iniciadoEm   DateTime?
  concluidoEm  DateTime?
  aprovadoEm   DateTime?
  aprovadoPorId String?
  atualizadoEm DateTime        @updatedAt

  aluno        Usuario         @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  licao        Licao           @relation(fields: [licaoId], references: [id], onDelete: Cascade)
  jornada      JornadaDoAluno? @relation(fields: [jornadaId], references: [id], onDelete: SetNull)

  @@unique([alunoId, licaoId])
  @@index([alunoId, estado])
  @@map("progresso_licoes")
}

/// Progresso do aluno numa unidade do currículo — serve para fase, módulo,
/// nível ou aula, porque a unidade é a mesma entidade em qualquer nível.
model ProgressoUnidade {
  id            String          @id @default(cuid())
  alunoId       String
  unidadeId     String
  jornadaId     String?
  estado        EstadoProgresso @default(NAO_INICIADO)
  percentual    Int             @default(0)
  aprovadoEm    DateTime?
  aprovadoPorId String?
  regraCodigo   String?
  regraVersao   Int?
  atualizadoEm  DateTime        @updatedAt

  aluno         Usuario           @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  unidade       UnidadeCurricular @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  jornada       JornadaDoAluno?   @relation(fields: [jornadaId], references: [id], onDelete: SetNull)

  @@unique([alunoId, unidadeId])
  @@index([jornadaId])
  @@map("progresso_unidades")
}

model Medalha {
  id          String   @id @default(cuid())
  alunoId     String
  metodoId    String
  unidadeId   String?
  jornadaId   String?
  codigo      String   @unique
  concedidaEm DateTime @default(now())
  instrutorId String?
  regraCodigo String?
  regraVersao Int?

  aluno       Usuario            @relation("alunoDaMedalha", fields: [alunoId], references: [id], onDelete: Cascade)
  metodo      Metodo             @relation(fields: [metodoId], references: [id], onDelete: Cascade)
  unidade     UnidadeCurricular? @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  jornada     JornadaDoAluno?    @relation(fields: [jornadaId], references: [id], onDelete: SetNull)
  instrutor   Usuario?           @relation("instrutorDaMedalha", fields: [instrutorId], references: [id], onDelete: SetNull)

  @@unique([alunoId, metodoId, unidadeId])
  @@map("medalhas")
}

model Certificado {
  id                  String    @id @default(cuid())
  alunoId             String
  metodoId            String?
  jornadaId           String?
  trilha              String
  fases               Json
  emitidoEm           DateTime  @default(now())
  cargaHorariaSegundos Int      @default(0)
  codigo              String    @unique
  arquivoId           String?
  revogadoEm          DateTime?
  revogadoMotivo      String?

  aluno               Usuario   @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  metodo              Metodo?         @relation(fields: [metodoId], references: [id], onDelete: SetNull)
  jornada             JornadaDoAluno? @relation(fields: [jornadaId], references: [id], onDelete: SetNull)
  arquivo             Arquivo?  @relation(fields: [arquivoId], references: [id], onDelete: SetNull)

  @@index([alunoId])
  @@map("certificados")
}

// ================================================ jornadas e turmas

enum SituacaoDaJornada {
  ATIVA
  CONCLUIDA
  INTERROMPIDA
  AGUARDANDO_LIBERACAO
}

/// A jornada do aluno em UM método de UM instrumento. Um mesmo aluno pode ter
/// várias jornadas ao mesmo tempo — MSA na fase 4, violino na fase 2,
/// saxofone na fase 1 — cada uma com progresso próprio.
model JornadaDoAluno {
  id             String            @id @default(cuid())
  alunoId        String
  instrumentoId  String?
  metodoId       String
  curriculoId    String
  unidadeAtualId String?
  progresso      Int               @default(0)
  status         SituacaoDaJornada @default(ATIVA)
  inicioEm       DateTime          @default(now())
  conclusaoEm    DateTime?
  observacao     String?
  atualizadoEm   DateTime          @updatedAt

  aluno          Usuario            @relation("alunoDaJornada", fields: [alunoId], references: [id], onDelete: Cascade)
  instrumento    Instrumento?       @relation(fields: [instrumentoId], references: [id], onDelete: SetNull)
  metodo         Metodo             @relation(fields: [metodoId], references: [id], onDelete: Cascade)
  curriculo      Curriculo          @relation(fields: [curriculoId], references: [id], onDelete: Cascade)
  unidadeAtual   UnidadeCurricular? @relation(fields: [unidadeAtualId], references: [id], onDelete: SetNull)

  progressoUnidades ProgressoUnidade[]
  progressoLicoes   ProgressoLicao[]
  matriculas        MatriculaEmTurma[]
  medalhas          Medalha[]
  certificados      Certificado[]

  @@unique([alunoId, metodoId, instrumentoId])
  @@index([status])
  @@map("jornadas_do_aluno")
}

/// Turma: instrumento + método + fase (unidade) + instrutor + localidade.
model Turma {
  id            String   @id @default(cuid())
  nome          String
  comumId       String
  instrumentoId String?
  metodoId      String
  unidadeId     String?
  instrutorId   String?
  status        Situacao @default(ATIVO)
  inicioEm      DateTime?
  encerradaEm   DateTime?
  observacao    String?
  criadoEm      DateTime @default(now())

  comum         Comum              @relation(fields: [comumId], references: [id], onDelete: Restrict)
  instrumento   Instrumento?       @relation(fields: [instrumentoId], references: [id], onDelete: SetNull)
  metodo        Metodo             @relation(fields: [metodoId], references: [id], onDelete: Cascade)
  unidade       UnidadeCurricular? @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  instrutor     Usuario?           @relation("instrutorDaTurma", fields: [instrutorId], references: [id], onDelete: SetNull)
  matriculas    MatriculaEmTurma[]

  @@index([comumId, status])
  @@index([instrutorId])
  @@map("turmas")
}

model MatriculaEmTurma {
  id         String   @id @default(cuid())
  turmaId    String
  alunoId    String
  jornadaId  String?
  entradaEm  DateTime @default(now())
  saidaEm    DateTime?

  turma      Turma           @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  aluno      Usuario         @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  jornada    JornadaDoAluno? @relation(fields: [jornadaId], references: [id], onDelete: SetNull)

  @@unique([turmaId, alunoId])
  @@map("matriculas_em_turma")
}

// ======================================== análise de método (importação)

enum StatusDaAnalise {
  SUGERIDA
  EM_REVISAO
  CONFIRMADA
  EDITADA
  REJEITADA
}

/// "Analisar método": a leitura dos documentos propõe uma estrutura, que
/// SEMPRE passa por revisão humana antes de virar currículo. Confirmar,
/// editar ou rejeitar é ato de gente, registrado com nome e data.
model AnaliseDeMetodo {
  id                String          @id @default(cuid())
  metodoId          String
  documentoId       String?
  origem            String          @default("importador")
  estruturaSugerida Json
  resumo            Json?
  avisos            Json?
  status            StatusDaAnalise @default(SUGERIDA)
  revisadoPorId     String?
  revisadoEm        DateTime?
  parecer           String?
  curriculoId       String?
  criadoEm          DateTime        @default(now())

  metodo            Metodo           @relation(fields: [metodoId], references: [id], onDelete: Cascade)
  documento         DocumentoMetodo? @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  revisadoPor       Usuario?         @relation(fields: [revisadoPorId], references: [id], onDelete: SetNull)

  @@index([metodoId, status])
  @@map("analises_de_metodo")
}

// ================================================== importação e fila

enum TipoImportacao {
  METODO_PLANILHA
  METODO_PDF
  METODO_DOCUMENTO
  COMUNS_CSV
  REGIOES_CSV
  ALUNOS_CSV
  QUESTOES_CSV
}

enum StatusImportacao {
  PREVIA
  APLICADA
  CANCELADA
  ERRO
}

model Importacao {
  id            String           @id @default(cuid())
  tipo          TipoImportacao
  nomeArquivo   String
  hashArquivo   String?
  executadaPorId String?
  status        StatusImportacao @default(PREVIA)
  resumo        Json?
  iniciadaEm    DateTime         @default(now())
  concluidaEm   DateTime?

  executadaPor  Usuario?         @relation(fields: [executadaPorId], references: [id], onDelete: SetNull)
  linhas        ImportacaoLinha[]

  @@map("importacoes")
}

enum StatusLinha {
  NOVO
  ATUALIZADO
  DUPLICADO
  ERRO
  PENDENTE_CONFERENCIA
}

model ImportacaoLinha {
  id            String      @id @default(cuid())
  importacaoId  String
  numeroLinha   Int
  dados         Json
  status        StatusLinha
  mensagem      String?

  importacao    Importacao  @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@index([importacaoId, status])
  @@map("importacoes_linhas")
}

enum EstadoTarefa {
  PENDENTE
  PROCESSANDO
  CONCLUIDA
  FALHOU
}

/// Fila no próprio banco: sem depender de serviço externo pago. O driver é
/// substituível (Redis/SQS) mantendo esta tabela como registro.
model Tarefa {
  id           String       @id @default(cuid())
  tipo         String
  carga        Json
  estado       EstadoTarefa @default(PENDENTE)
  tentativas   Int          @default(0)
  rodarEm      DateTime     @default(now())
  iniciadaEm   DateTime?
  concluidaEm  DateTime?
  erro         String?
  criadoEm     DateTime     @default(now())

  @@index([estado, rodarEm])
  @@map("tarefas")
}

# ---------------------------------------------------------------- banco
# Duas identidades, de propósito:
#   • a aplicação usa um papel SEM BYPASSRLS — o banco filtra por vínculo;
#   • migrações, importação e seeds usam o dono do schema.
DATABASE_URL="postgresql://estudos_app:TROCAR@localhost:5432/estudos_musicais?schema=public"
DATABASE_URL_MIGRACAO="postgresql://estudos:TROCAR@localhost:5432/estudos_musicais?schema=public"
SHADOW_DATABASE_URL="postgresql://estudos:TROCAR@localhost:5432/estudos_musicais_sombra?schema=public"

# Publicando sem servidor (Vercel e afins): DATABASE_URL aponta para o
# ENDEREÇO COM POOLER e DATABASE_URL_MIGRACAO para o endereço DIRETO — o
# Prisma Migrate precisa de conexão direta, e a aplicação precisa do pooler.
#   DATABASE_URL="postgresql://estudos_app:...@ep-xxx-pooler.sa-east-1.aws.neon.tech/estudos?sslmode=require&pgbouncer=true"
#   DATABASE_URL_MIGRACAO="postgresql://estudos:...@ep-xxx.sa-east-1.aws.neon.tech/estudos?sslmode=require"
# BANCO_MAX_CONEXOES="1"
# PAPEL_APLICACAO="estudos_app"

# Bancos exclusivos dos testes de integração (são recriados à vontade).
DATABASE_URL_TESTES="postgresql://estudos:TROCAR@localhost:5432/estudos_musicais_testes?schema=public"
DATABASE_URL_TESTES_APP="postgresql://estudos_app:TROCAR@localhost:5432/estudos_musicais_testes?schema=public"

# ------------------------------------------------------------- aplicação
# Segredo de sessão: 32 bytes aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SEGREDO_SESSAO="TROCAR"
NODE_ENV="development"

# ----------------------------------------------- primeiro administrador
# Só é usado quando o banco não tem NENHUM usuário. A senha vale uma vez: o
# sistema exige a troca na primeira entrada. Depois disso, todo cadastro é
# feito por quem já tem acesso — não existe autocadastro.
ADMIN_INICIAL_NOME="Renato Monteiro"
ADMIN_INICIAL_LOGIN="Renato Monteiro"
ADMIN_INICIAL_EMAIL="renato.monteiro@exemplo.org"
ADMIN_INICIAL_SENHA="CCV123"

# ---------------------------------------------------------- armazenamento
# "disco" guarda os anexos numa pasta privada do servidor; "s3" usa qualquer
# serviço compatível (MinIO, Wasabi, Backblaze, S3). Nada é público: o acesso
# passa por rota autenticada que confere o vínculo de quem pede.
#
# Publicando sem servidor, "disco" NÃO serve: o sistema de arquivos é somente
# leitura e some a cada invocação. Use "s3".
ARMAZENAMENTO_DRIVER="disco"
ARMAZENAMENTO_DIRETORIO="./armazenamento"
# S3_ENDPOINT="http://localhost:9000"
# S3_REGIAO="us-east-1"
# S3_BUCKET="estudos-musicais"
# S3_CHAVE="..."
# S3_SEGREDO="..."

# ------------------------------------------------------------------ fila
# A fila vive no próprio banco (tabela tarefas). O driver é substituível.
FILA_DRIVER="banco"
FILA_TENTATIVAS="5"

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "installCommand": "npm install --workspace web --include-workspace-root",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:caminho*",
      "destination": "https://TROQUE-PELA-URL-DA-SUA-API.onrender.com/api/:caminho*"
    }
  ]
}
